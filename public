<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secret Room</title>
    <style>
        body { font-family: sans-serif; margin: 0; padding: 20px; background: #333; color: #333; }
        #login-area { text-align: center; margin-top: 50px; background: white; padding: 30px; border-radius: 8px; max-width: 300px; margin-left: auto; margin-right: auto; }
        #chat-area { display: none; max-width: 500px; margin: 0 auto; background: white; padding: 20px; border-radius: 8px; }
        #messages { height: 60vh; overflow-y: auto; border: 1px solid #ccc; padding: 10px; margin-bottom: 10px; background: #fafafa; }
        .msg { margin-bottom: 8px; padding: 10px; background: #e1ffc7; border-radius: 5px; display: inline-block; word-break: break-all; }
        .msg-wrapper { clear: both; }
        .input-group { display: flex; gap: 10px; }
        input[type="text"], input[type="password"] { flex-grow: 1; padding: 10px; border: 1px solid #ccc; border-radius: 4px; }
        button { padding: 10px 15px; cursor: pointer; border: none; border-radius: 4px; background: #007bff; color: white; }
        .delete-btn { background: #ff4d4d; width: 100%; margin-top: 15px; font-weight: bold; }
    </style>
</head>
<body>
    <div id="login-area">
        <h3>合言葉を入力</h3>
        <input type="password" id="password" placeholder="パスワード">
        <button onclick="login()" style="margin-top: 15px; width: 100%;">入室</button>
    </div>

    <div id="chat-area">
        <div id="messages"></div>
        <div class="input-group">
            <input type="text" id="messageInput" placeholder="メッセージを入力...">
            <button onclick="sendMessage()">送信</button>
        </div>
        <button class="delete-btn" onclick="clearMessages()">履歴を手動で全削除</button>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        let isLoggedIn = false;

        // Enterキーで送信・ログインできるようにする
        document.getElementById('password').addEventListener('keypress', function (e) { if (e.key === 'Enter') login(); });
        document.getElementById('messageInput').addEventListener('keypress', function (e) { if (e.key === 'Enter') sendMessage(); });

        function login() {
            const pwd = document.getElementById('password').value;
            socket.emit('login', pwd, (response) => {
                if (response.success) {
                    document.getElementById('login-area').style.display = 'none';
                    document.getElementById('chat-area').style.display = 'block';
                    isLoggedIn = true;
                    response.history.forEach(addMessageToScreen);
                } else {
                    alert('パスワードが違います');
                }
            });
        }

        function sendMessage() {
            const input = document.getElementById('messageInput');
            const msg = input.value.trim();
            if (msg && isLoggedIn) {
                socket.emit('chat message', msg);
                input.value = '';
            }
        }

        function clearMessages() {
            if (confirm('本当にお互いの画面から履歴を完全に消去しますか？')) {
                socket.emit('clear history');
            }
        }

        socket.on('chat message', (msg) => {
            addMessageToScreen(msg);
        });

        socket.on('history cleared', () => {
            document.getElementById('messages').innerHTML = ''; // 画面を真っ白にする
        });

        function addMessageToScreen(msg) {
            const messagesDiv = document.getElementById('messages');
            const wrapper = document.createElement('div');
            wrapper.className = 'msg-wrapper';
            const div = document.createElement('div');
            div.textContent = msg;
            div.className = 'msg';
            
            wrapper.appendChild(div);
            messagesDiv.appendChild(wrapper);
            messagesDiv.scrollTop = messagesDiv.scrollHeight; // 一番下までスクロール
        }
    </script>
</body>
</html>
